%% Flow: Password Reset
%% Applies: 2 (password reset email is sent by Auth0, an external delivery call), 4 (new password validation happens on the Auth0-hosted reset screen)
%% N/A: 1 (no list or table), 3 (no AI generation), 5 (no duplicate or conflict entity, the account-exists check is deliberately non-leaking rather than a conflict), 6 (no destructive action), 7 (no referenced-elsewhere dependency), 8 (short flow, no session exists yet to expire)
flowchart LR
    classDef startEnd fill:#B3FFCC,stroke:#4CBB77,stroke-width:2px,color:#1A1A1A
    classDef screen fill:#B3D9FF,stroke:#4A90D9,stroke-width:2px,color:#1A1A1A
    classDef system fill:#E0E0E0,stroke:#9E9E9E,stroke-width:2px,color:#1A1A1A
    classDef decision fill:#FFE066,stroke:#E6B800,stroke-width:2px,color:#1A1A1A
    classDef errorNode fill:#FFB3B3,stroke:#E05C5C,stroke-width:2px,stroke-dasharray: 5 5,color:#1A1A1A

    A(["Start: from auth/log-in, clicks forgot password"]):::startEnd -->|"Auth0 shows forgot-password screen"| B["Screen (Auth0-hosted): Enter email address"]:::screen
    B -->|"submits email"| C{"Decision (Auth0-hosted): Account exists for this email?"}:::decision
    C -->|"Yes"| D[["System: Auth0 sends password reset email"]]:::system
    D -->|"send failed"| D1["Error: Reset email send failure"]:::errorNode
    D1 -.->|"retries send"| D
    D -->|"email sent"| F["Screen (Auth0-hosted): Check your email confirmation"]:::screen
    C -->|"No"| E["Edge case (Auth0-hosted): No account found for this email"]:::errorNode
    E -->|"shows same confirmation regardless of account existing"| F

    F -->|"clicks reset link"| G[["System: Auth0 validates reset token"]]:::system
    G -->|"token checked"| H{"Decision (Auth0-hosted): Link state?"}:::decision
    H -->|"Valid"| I["Screen (Auth0-hosted): Set new password"]:::screen
    H -->|"Expired"| J["Edge case (Auth0-hosted): Link expired"]:::errorNode
    J -.->|"requests new link"| B
    H -->|"Already used"| K["Edge case (Auth0-hosted): Link already used"]:::errorNode
    K -.->|"requests new link"| B

    I -->|"submits new password"| L{"Decision (Auth0-hosted): New password meets requirements?"}:::decision
    L -->|"No"| M["Error (Auth0-hosted): Password fails strength requirements"]:::errorNode
    M -.->|"tries again"| I
    L -->|"Yes"| N{"Decision (Auth0-hosted): Same as current password?"}:::decision
    N -->|"Yes"| O["Error (Auth0-hosted): New password same as old password"]:::errorNode
    O -.->|"tries again"| I
    N -->|"No"| P[["System: Auth0 updates password"]]:::system
    P -->|"password updated"| Q["Screen (Auth0-hosted): Password updated confirmation"]:::screen
    Q -->|"returns to app"| End(["End: continues in auth/log-in"]):::startEnd
