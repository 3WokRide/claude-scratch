%% Flow: Password Reset
%% Applies: 2 (password reset email is an external email delivery call), 4 (new password validation)
%% N/A: 1 (no list or table), 3 (no AI generation), 5 (no duplicate or conflict entity, the account-exists check is deliberately non-leaking rather than a conflict), 6 (no destructive action), 7 (no referenced-elsewhere dependency), 8 (short flow, no session exists yet to expire)
flowchart LR
    classDef startEnd fill:#B3FFCC,stroke:#4CBB77,stroke-width:2px,color:#1A1A1A
    classDef screen fill:#B3D9FF,stroke:#4A90D9,stroke-width:2px,color:#1A1A1A
    classDef system fill:#E0E0E0,stroke:#9E9E9E,stroke-width:2px,color:#1A1A1A
    classDef decision fill:#FFE066,stroke:#E6B800,stroke-width:2px,color:#1A1A1A
    classDef errorNode fill:#FFB3B3,stroke:#E05C5C,stroke-width:2px,stroke-dasharray: 5 5,color:#1A1A1A

    A(["Start: from auth/log-in"]):::startEnd -->|"clicks forgot password"| B["Screen: Enter email address"]:::screen
    B -->|"submits email"| C{"Decision: Account exists for this email?"}:::decision
    C -->|"Yes"| D[["System: Send password reset email"]]:::system
    D -->|"send failed"| D1["Error: Reset email send failure"]:::errorNode
    D1 -.->|"retries send"| D
    D -->|"email sent"| F["Screen: Check your email"]:::screen
    C -->|"No"| E["Edge case: No account found for this email"]:::errorNode
    E -->|"shows same confirmation regardless of account existing"| F

    F -->|"clicks reset link"| G[["System: Validate reset token"]]:::system
    G -->|"token checked"| H{"Decision: Link state?"}:::decision
    H -->|"Valid"| I["Screen: Set new password"]:::screen
    H -->|"Expired"| J["Edge case: Link expired"]:::errorNode
    J -.->|"requests new link"| B
    H -->|"Already used"| K["Edge case: Link already used"]:::errorNode
    K -.->|"requests new link"| B

    I -->|"submits new password"| L{"Decision: New password meets requirements?"}:::decision
    L -->|"No"| M["Error: Password fails strength requirements"]:::errorNode
    M -.->|"tries again"| I
    L -->|"Yes"| N{"Decision: Same as current password?"}:::decision
    N -->|"Yes"| O["Error: New password same as old password"]:::errorNode
    O -.->|"tries again"| I
    N -->|"No"| P[["System: Update password"]]:::system
    P -->|"password updated"| End(["End: continues in auth/log-in"]):::startEnd
