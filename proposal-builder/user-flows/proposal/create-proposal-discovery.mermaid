%% Flow: Create Proposal - Discovery
%% Applies: 1 (GBP lookup returns an empty result set), 2 (GBP API unavailable or rate-limited), 3 (AI Strengths and Opportunities generation fails or times out, blocks proceeding, no manual fallback), 4 (zero Bundles selected is a required-selection validation), 8 (session expiry mid-step)
%% N/A: 5 (duplicate detection on GBP import is handled in host/gbp-search-import, not repeated here), 6 (no destructive action in this flow), 7 (nothing is deleted or edited here that other records depend on)
flowchart LR
    classDef startEnd fill:#B3FFCC,stroke:#4CBB77,stroke-width:2px,color:#1A1A1A
    classDef screen fill:#B3D9FF,stroke:#4A90D9,stroke-width:2px,color:#1A1A1A
    classDef system fill:#E0E0E0,stroke:#9E9E9E,stroke-width:2px,color:#1A1A1A
    classDef decision fill:#FFE066,stroke:#E6B800,stroke-width:2px,color:#1A1A1A
    classDef errorNode fill:#FFB3B3,stroke:#E05C5C,stroke-width:2px,stroke-dasharray: 5 5,color:#1A1A1A

    A1(["Start: from dashboard/dashboard-overview, Host not yet known"]):::startEnd -->|"starts New Proposal"| B{"Decision: is the Host already known?"}:::decision
    A2(["Start: from host/single-host-view, Host already known"]):::startEnd -->|"starts new Proposal for this Host"| B
    A3(["Start: from proposal/browse-proposals, Host not yet known"]):::startEnd -->|"prompted to create a Proposal"| B

    B -->|"Host unknown, needs GBP search"| C["Screen: search Google Business Profile"]:::screen
    B -->|"Host already known, GBP step skipped"| F[["System: AI generates Strengths and Opportunities"]]:::system

    C -->|"submits business name or address"| D[["System: GBP lookup"]]:::system
    D -->|"matches found"| E["Screen: GBP results list"]:::screen
    D -->|"no results for the query"| ERR1["Edge case: GBP lookup returns no results"]:::errorNode
    ERR1 -.->|"refines the search"| C
    D -->|"GBP unavailable or rate-limited"| ERR2["Error: GBP API unavailable or rate-limited"]:::errorNode
    ERR2 -.->|"retries lookup"| D
    E -->|"picks the business"| F

    F -->|"generation succeeds"| G["Screen: Strengths and Opportunities overview"]:::screen
    F -->|"generation fails or times out"| ERR3["Error: AI analysis generation fails or times out, blocks proceeding"]:::errorNode
    ERR3 -.->|"retries generation"| F

    G -->|"clicks proceed"| H["Screen: Problem-Solution Bundles selection"]:::screen
    G -->|"session expires"| ERR4["Edge case: session expires mid-step"]:::errorNode
    G -->|"saves as Draft"| END_DRAFT(["End: continues in proposal/save-and-resume-draft"]):::startEnd

    H -->|"clicks continue to customize"| I{"Decision: at least one Bundle selected?"}:::decision
    H -->|"session expires"| ERR4
    H -->|"saves as Draft"| END_DRAFT

    ERR4 -->|"redirects to log in"| END_AUTH(["End: continues in auth/log-in"]):::startEnd

    I -->|"one or more Bundles selected"| END_CUSTOMIZE(["End: continues in proposal/create-proposal-customize"]):::startEnd
    I -->|"zero Bundles selected"| ERR5["Edge case: zero Bundles selected"]:::errorNode
    ERR5 -.->|"returns to select Bundles"| H
