%% Flow: Regenerate Proposal Section
%% Applies: 3 (AI regeneration failure or timeout), 6 (overwriting unsaved manual edits needs a confirm-style warning)
%% N/A: 1 (no empty or first-run list state in this flow), 2 (no external API call, this is an internal AI call not GBP or Slides), 4 (input adjustment here is not a submitted form to validate), 5 (no duplicate or naming conflict in this flow), 7 (nothing referenced elsewhere breaks in this step), 8 (short flow, no session-expiry risk called out for regeneration)
flowchart TD
    classDef startEnd fill:#B3FFCC,stroke:#4CBB77,stroke-width:2px,color:#1A1A1A
    classDef screen fill:#B3D9FF,stroke:#4A90D9,stroke-width:2px,color:#1A1A1A
    classDef system fill:#E0E0E0,stroke:#9E9E9E,stroke-width:2px,color:#1A1A1A
    classDef decision fill:#FFE066,stroke:#E6B800,stroke-width:2px,color:#1A1A1A
    classDef errorNode fill:#FFB3B3,stroke:#E05C5C,stroke-width:2px,stroke-dasharray: 5 5,color:#1A1A1A

    S1(["Start: from proposal/create-proposal-generate-preview"]):::startEnd -->|"selects regenerate on a Section"| A["Screen: pick Section to regenerate"]:::screen
    S2(["Start: from proposal/revise-proposal"]):::startEnd -->|"selects regenerate on a Section"| A

    A -->|"chooses a Section"| B{"Decision: does the Section have unsaved manual edits?"}:::decision
    B -->|"no unsaved edits"| D["Screen: adjust Section inputs"]:::screen
    B -->|"has unsaved edits"| C["Edge case: Section has unsaved manual edits"]:::errorNode
    C -->|"proceeds, discarding edits"| D
    C -->|"cancels regeneration"| END_CANCEL(["End: continues in proposal/create-proposal-generate-preview"]):::startEnd

    D -->|"confirms inputs"| E[["System: AI regenerates Section"]]:::system
    E -->|"regeneration attempt completes"| D1{"Decision: regeneration result?"}:::decision
    D1 -->|"succeeded"| F["Screen: compare old versus new Section"]:::screen
    D1 -->|"failed"| G["Error: Section regeneration failed, prior content preserved"]:::errorNode
    D1 -->|"timed out"| H["Error: Section regeneration timed out, prior content preserved"]:::errorNode

    G -.->|"retries regeneration"| E
    G -->|"keeps existing content"| END_KEEP(["End: continues in proposal/create-proposal-generate-preview"]):::startEnd
    H -.->|"retries regeneration"| E
    H -->|"keeps existing content"| END_KEEP

    F -->|"accepts new Section"| I[["System: save Section"]]:::system
    F -->|"reverts to prior Section"| J[["System: restore prior Section"]]:::system
    I -->|"Section saved"| END_ACCEPT(["End: continues in proposal/create-proposal-generate-preview"]):::startEnd
    J -->|"prior Section restored"| END_REVERT(["End: continues in proposal/create-proposal-generate-preview"]):::startEnd
