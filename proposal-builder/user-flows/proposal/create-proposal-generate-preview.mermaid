%% Flow: Create Proposal - Generate and Preview
%% Applies: 3 (AI generation fails, times out, or hits quota, all-or-nothing across every Section), 8 (session expiry during a long generation)
%% N/A: 1 (no empty or first-run list state in this flow), 2 (Slides export is not a separate step, generation produces the deck directly), 4 (no submitted form here), 5 (no duplicate or naming conflict in this flow), 6 (preview has no inline edit surface, editing always routes through edit-proposal), 7 (nothing referenced elsewhere breaks in this step)
flowchart TD
    classDef startEnd fill:#B3FFCC,stroke:#4CBB77,stroke-width:2px,color:#1A1A1A
    classDef screen fill:#B3D9FF,stroke:#4A90D9,stroke-width:2px,color:#1A1A1A
    classDef system fill:#E0E0E0,stroke:#9E9E9E,stroke-width:2px,color:#1A1A1A
    classDef decision fill:#FFE066,stroke:#E6B800,stroke-width:2px,color:#1A1A1A
    classDef errorNode fill:#FFB3B3,stroke:#E05C5C,stroke-width:2px,stroke-dasharray: 5 5,color:#1A1A1A

    S1(["Start: from proposal/create-proposal-customize"]):::startEnd -->|"continues to preview"| G1[["System: AI generates the whole Proposal in one go, produces the Google Slides deck"]]:::system

    G1 -->|"generation succeeds"| SAVED[["System: save Proposal on Host"]]:::system
    G1 -->|"generation fails"| ERR_GEN["Error: proposal generation failed"]:::errorNode
    ERR_GEN -.->|"retries generation"| G1
    G1 -->|"generation timed out"| ERR_TO["Error: proposal generation timed out"]:::errorNode
    ERR_TO -.->|"retries generation"| G1
    G1 -->|"AI quota or rate limit reached"| ERR_QUOTA["Error: AI quota or rate limit reached"]:::errorNode
    ERR_QUOTA -.->|"retries later"| G1

    G1 -->|"session expires during generation"| ERR_SESS["Edge case: session expires during generation"]:::errorNode
    ERR_SESS -->|"redirects to log in"| END_AUTH(["End: continues in auth/log-in"]):::startEnd
    G1 -->|"user navigates away while generation runs"| ERR_NAV["Edge case: generation still running when user navigates away"]:::errorNode
    ERR_NAV -->|"generation continues in background, notifies when ready"| SAVED

    SAVED -->|"save complete"| PREV["Screen: preview, the generated Google Slides deck"]:::screen

    PREV -->|"wants to edit the Proposal"| END_EDIT(["End: continues in proposal/edit-proposal"]):::startEnd
    PREV -->|"done"| END_DONE(["End: Proposal saved on Host, Slides link ready"]):::startEnd
